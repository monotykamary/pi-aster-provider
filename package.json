{
  "name": "pi-aster-provider",
  "version": "1.0.18",
  "description": "Aster (asterlab.ai) provider extension for pi - Access Kimi K3, GLM 5.2, GPT-OSS, and batch models through the Aster API",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit && vitest run && node scripts/test-pi-compat.mjs",
    "test": "vitest run",
    "update-models": "node scripts/update-models.js",
    "test:pi": "node scripts/test-pi-compat.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "aster",
    "asterlab",
    "ai",
    "llm",
    "kimi",
    "moonshot",
    "glm",
    "gpt-oss",
    "coding"
  ],
  "author": "",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-aster-provider.git"
  }
}
